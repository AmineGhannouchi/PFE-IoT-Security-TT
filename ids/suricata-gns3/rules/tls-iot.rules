# ============================================================
# PFE IoT Security — Règles TLS / JA4 (trafic MQTT chiffré réel)
# Zone Analyse — détection sur le handshake TLS 1.3 et la volumétrie
#
# Le trafic MQTT du labo est chiffré en TLS 1.3 mTLS : le contenu
# applicatif n'est pas lisible en passif. Ces règles détectent les
# attaques via les métadonnées TLS (JA4, version, volume, source).
# Complémentaires des SID 9000001-9000004 (mqtt-iot.rules).
# ============================================================

# ----- SID 1000001 : baseline — connexion TLS au broker -----
alert tls any any -> $MQTT_BROKER 8883 ( \
    msg:"PFE [INFO] TLS connection to MQTT broker 8883"; \
    tls.version:"TLS 1.3"; \
    sid:1000001; rev:2;)

# ----- SID 1000002 : empreinte JA4 connue du fleet-sim -----
# JA4 légitime observé dans eve.json : t13i030900_55b375c5d22e_3217d83565aa
alert tls any any -> $MQTT_BROKER 8883 ( \
    msg:"PFE [INFO] Known fleet-sim client JA4 fingerprint"; \
    ja4:"t13i030900_55b375c5d22e_3217d83565aa"; \
    sid:1000002; rev:1;)

# ----- SID 1000010 : DoS — flood de handshakes TLS (scénario S5) -----
# Équivalent volumétrique du SID 9000001 sur trafic chiffré
alert tcp any any -> $MQTT_BROKER 8883 ( \
    msg:"PFE [HIGH] DoS - Excessive TLS connections (MQTT flood)"; \
    flags:S; \
    threshold:type threshold, track by_src, count 50, seconds 10; \
    classtype:denial-of-service; \
    sid:1000010; rev:2;)

# ----- SID 1000011 : connexion depuis un réseau non-IoT (scan/MITM) -----
# Seul 192.168.10.0/24 (zone IoT) doit contacter le broker
alert tls !$IOT_NET any -> $MQTT_BROKER 8883 ( \
    msg:"PFE [HIGH] Unauthorized network connecting to MQTT broker"; \
    classtype:attempted-recon; \
    sid:1000011; rev:2;)

# ----- SID 1000012 : volume TCP élevé (replay / exfiltration) -----
alert tcp $IOT_NET any -> $MQTT_BROKER 8883 ( \
    msg:"PFE [WARN] High volume TCP flow to MQTT broker"; \
    flow:established,to_server; \
    threshold:type threshold, track by_src, count 50, seconds 5; \
    classtype:policy-violation; \
    sid:1000012; rev:2;)

# ----- SID 1000013 : connexion MQTT en CLAIR (port 1883) — MITM S1 -----
# Le broker doit être exclusivement sur 8883 (TLS). Tout 1883 = anomalie
alert tcp any any -> $MQTT_BROKER 1883 ( \
    msg:"PFE [HIGH] Unencrypted MQTT connection on port 1883 (MITM risk)"; \
    flow:to_server; \
    classtype:policy-violation; \
    sid:1000013; rev:1;)

# ----- SID 1000014 : version TLS obsolète (< 1.3) vers le broker -----
alert tls any any -> $MQTT_BROKER 8883 ( \
    msg:"PFE [HIGH] Obsolete TLS version to MQTT broker (policy: TLS 1.3 only)"; \
    tls.version:!"TLS 1.3"; \
    classtype:protocol-command-decode; \
    sid:1000014; rev:1;)
