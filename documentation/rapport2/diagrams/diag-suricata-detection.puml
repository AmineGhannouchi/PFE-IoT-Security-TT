@startuml diag-suricata-detection

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ActivityBackgroundColor #FFF3E0
skinparam ActivityBorderColor #E65100

title Diagramme d'Activité — Pipeline de Détection Suricata IDS

start

:Recevoir le trafic réseau\n(port mirroring depuis MikroTik);

:Capture via AF_PACKET\n(mode haute performance);

:Décoder les couches réseau\n(Ethernet → IP → TCP);

if (Port 8883 ?) then (oui)
  :Activer le parseur MQTT\n(app-layer-protocol: mqtt);

  :Extraire les métadonnées MQTT\n(type, topic, QoS, payload size);

  partition "Application des règles" {

    if (Connexions MQTT > 50 en 10s\ndepuis la même source ?) then (oui)
      :Générer alerte SID 9000001\n"IoT DoS — MQTT connection flood"\nSévérité : 2 (Denial of Service);
    endif

    if (Topic commence par "cmd/" ?) then (oui)
      :Générer alerte SID 9000002\n"IoT Suspicious command topic"\nSévérité : 3 (Policy Violation);
    endif

    if (Payload MQTT > 4096 octets ?) then (oui)
      :Générer alerte SID 9000003\n"IoT Oversized MQTT payload"\nSévérité : 2 (Attempted Intrusion);
    endif

    if (Connexions > 20 en 5s\nsans subscribe ?) then (oui)
      :Générer alerte SID 9000004\n"IoT MQTT broker scanning"\nSévérité : 3 (Network Scan);
    endif
  }

else (non)
  :Appliquer les règles standard\n(ET Open, Suricata built-in);
endif

if (Alerte générée ?) then (oui)
  :Écrire dans eve.json\n(format EVE JSON);

  :Inclure : timestamp, src_ip,\ndst_ip, proto, alert.signature,\nalert.category, mqtt metadata;

  :Wazuh ingère l'alerte\n(logcollector json);
else (non)
  :Trafic normal — pas d'alerte;
endif

stop

note right
  Résultats :
  — 51 alertes sur 76 000 messages
  — 23 DoS, 15 injection, 9 scan, 4 cmd
  — 0 faux positifs sur trafic TLS normal
end note

@enduml
