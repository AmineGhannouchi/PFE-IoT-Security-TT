@startuml diag-architecture-generale

!define RECTANGLE class
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false

skinparam component {
  BackgroundColor<<IoT>> #E8F5E9
  BackgroundColor<<Security>> #FFF3E0
  BackgroundColor<<SIEM>> #E3F2FD
  BackgroundColor<<PKI>> #FCE4EC
  BackgroundColor<<Network>> #F3E5F5
  BackgroundColor<<ML>> #E0F2F1
  BorderColor #555555
}

title Architecture Générale — Sécurisation E2E des Flux IoT\nFST / Tunisie Telecom — 2025-2026

package "Zone IoT\n192.168.10.0/24" <<IoT>> #E8F5E9 {
  [Capteurs MQTT\n(paho-mqtt TLS 1.3)] <<IoT>> as MQTT_DEV
  [Capteurs CoAP\n(aiocoap DTLS)] <<IoT>> as COAP_DEV
  [Clients HTTP\n(HTTPS)] <<IoT>> as HTTP_DEV
}

package "Zone DMZ — Services\n192.168.20.0/24" <<Security>> #FFF9C4 {
  [Broker MQTT\nMosquitto v2.0\nPort 8883 (TLS/mTLS)] <<Security>> as BROKER
  [Gateway CoAP\naiocoap\nPort 5684 (DTLS)] <<Security>> as COAP_GW
  [Gateway HTTP\nnginx\nPort 443 (HTTPS)] <<Security>> as HTTP_GW
}

package "Zone PKI\n192.168.30.0/24" <<PKI>> #FCE4EC {
  [HashiCorp Vault\nPKI Engine v1.15\nPort 8200] <<PKI>> as VAULT
  note right of VAULT
    CA Racine (RSA-4096)
    CA Intermédiaire (RSA-2048)
    Rôles : services, iot-devices
  end note
}

package "Zone SIEM\n192.168.40.0/24" <<SIEM>> #E3F2FD {
  [Wazuh Manager\nv4.7] <<SIEM>> as WAZUH
  [OpenSearch\nIndexation] <<SIEM>> as OPENSEARCH
  [Dashboards\nVisualisation] <<SIEM>> as DASHBOARDS
}

package "Zone Analyse\n192.168.50.0/24" <<ML>> #E0F2F1 {
  [Suricata IDS\nv7.0 — MQTT natif] <<ML>> as SURICATA
  [ML Engine\nIsolationForest\nRandomForest] <<ML>> as ML_ENGINE
}

package "Infrastructure Réseau" <<Network>> #F3E5F5 {
  [pfSense CE\nFirewall / NAT] <<Network>> as PFSENSE
  [MikroTik CHR\nRouteur L3 / VLAN] <<Network>> as MIKROTIK
}

' Flux chiffrés IoT -> DMZ
MQTT_DEV --> BROKER : MQTT/TLS 1.3\n(mTLS)
COAP_DEV --> COAP_GW : CoAP/DTLS
HTTP_DEV --> HTTP_GW : HTTPS

' PKI provisioning
BROKER <..> VAULT : Certificats X.509
COAP_GW <..> VAULT : Certificats X.509
HTTP_GW <..> VAULT : Certificats X.509
MQTT_DEV <..> VAULT : Émission certificats\ndevices (TTL 24h)

' Réseau
PFSENSE --> MIKROTIK : Trunk 802.1Q
MIKROTIK --> BROKER : Routage inter-VLAN

' Supervision
BROKER --> WAZUH : Logs MQTT
SURICATA --> WAZUH : Alertes IDS (EVE JSON)
WAZUH --> OPENSEARCH : Indexation
OPENSEARCH --> DASHBOARDS : Visualisation

' Analyse
SURICATA --> ML_ENGINE : Données réseau
ML_ENGINE ..> WAZUH : Scores anomalie

@enduml
