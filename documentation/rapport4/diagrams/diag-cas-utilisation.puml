@startuml diag-cas-utilisation

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam shadowing false
skinparam usecase {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam actor {
  BackgroundColor #FAFAFA
  BorderColor #555555
}

title Diagramme de Cas d'Utilisation\nÉcosystème IoT Sécurisé

left to right direction

rectangle "Dispositif IoT\n(Capteur)" as DEV
actor "Administrateur\nSécurité" as ADMIN
actor "Opérateur\nTT (SOC)" as SOC

rectangle "Système de Sécurisation IoT E2E" {

  usecase "Demander un\ncertificat X.509" as UC1
  usecase "Se connecter\nau broker MQTT" as UC2
  usecase "Publier des\ndonnées télémétrie" as UC3
  usecase "Renouveler\nle certificat" as UC4

  usecase "Configurer\nla PKI Vault" as UC5
  usecase "Définir les\nrègles ACL" as UC6
  usecase "Configurer\nles règles IDS" as UC7
  usecase "Déployer les\nrègles SIEM" as UC8

  usecase "Consulter le\ndashboard Wazuh" as UC9
  usecase "Analyser les\nalertes IDS" as UC10
  usecase "Lancer la détection\nML d'anomalies" as UC11
  usecase "Évaluer les\nperformances" as UC12

  usecase "Authentification\nmTLS" as UC_AUTH
  usecase "Chiffrement\nTLS 1.3" as UC_TLS
  usecase "Vérification\nchaîne CA" as UC_VERIF
}

DEV --> UC1
DEV --> UC2
DEV --> UC3
DEV --> UC4

ADMIN --> UC5
ADMIN --> UC6
ADMIN --> UC7
ADMIN --> UC8

SOC --> UC9
SOC --> UC10
SOC --> UC11
SOC --> UC12

UC2 ..> UC_AUTH : <<include>>
UC2 ..> UC_TLS : <<include>>
UC1 ..> UC_VERIF : <<include>>
UC3 ..> UC_TLS : <<include>>

@enduml
