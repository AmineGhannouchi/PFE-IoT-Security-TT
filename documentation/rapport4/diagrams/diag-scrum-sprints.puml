@startuml diag-scrum-sprints

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false
skinparam monochrome true
skinparam linetype ortho
skinparam nodesep 22
skinparam ranksep 20
skinparam rectangle {
  BorderColor Black
  BackgroundColor White
  FontColor Black
  RoundCorner 12
}
skinparam ArrowColor Black
skinparam ArrowThickness 1.2

title Enchaînement des six sprints\nVue chronologique des livrables

rectangle "**S1**\nCadrage\n& réseau" as S1
rectangle "**S2**\nPKI\nVault" as S2
rectangle "**S3**\nBroker\nmTLS" as S3
rectangle "**S4**\nFlotte\nsimulée" as S4
rectangle "**S5**\nDétection\nIDS + SIEM" as S5
rectangle "**S6**\nML\n& bilan" as S6

S1 -right-> S2
S2 -right-> S3
S3 -right-> S4
S4 -right-> S5
S5 -right-> S6

@enduml
