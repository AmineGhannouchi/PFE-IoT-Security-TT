@startuml diag-scrum-sprints

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false
skinparam monochrome true
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 30
skinparam rectangle {
  BorderColor Black
  BackgroundColor White
  FontColor Black
  RoundCorner 12
}
skinparam ArrowColor Black
skinparam ArrowThickness 1.2

title Enchaînement des six sprints\nVue chronologique des livrables

rectangle "**S1 -- Cadrage & réseau**\n2 semaines\nTopologie GNS3 segmentée\nPlan d'adressage VLAN\nConteneurs de base" as S1
rectangle "**S2 -- PKI Vault**\n2 semaines\nVault déployé\nCA racine + intermédiaire\nScripts d'émission" as S2
rectangle "**S3 -- Broker mTLS**\n2 semaines\nMosquitto TLS 1.3 + mTLS\nACL par certificat\nTests d'authentification" as S3
rectangle "**S4 -- Flotte simulée**\n2 semaines\n50 clients Python\nGénération de trafic\nRejeu de 76 000 messages" as S4
rectangle "**S5 -- Détection IDS + SIEM**\n2 semaines\nRègles Suricata MQTT\nIntégration Wazuh\nDashboards et alertes" as S5
rectangle "**S6 -- ML & bilan**\n2 semaines\nIsolation Forest + Random Forest\nÉvaluation des performances\nRédaction finale" as S6

S1 -right-> S2
S2 -down-> S3
S3 -left-> S4
S4 -down-> S5
S5 -right-> S6

@enduml
