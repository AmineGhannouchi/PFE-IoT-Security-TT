@startuml diag-uc-global

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam shadowing false
skinparam monochrome true
skinparam dpi 150

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

title Diagramme de cas d'utilisation global

left to right direction

' ── Acteur systeme secondaire (declare en premier pour l'ancrer en haut a droite) ──

rectangle "<<acteur systeme>>\nDispositif IoT" as DEV

' ── Acteurs humains (a gauche) ──

actor "Administrateur\nSecurite" as ADMIN
actor "Operateur\nSOC" as SOC

' ── Systeme ──

rectangle "Plateforme de securisation IoT" {

  ' --- Cas du Dispositif IoT ---
  usecase "Demander un\ncertificat X.509" as UC1
  usecase "Se connecter au\nbroker MQTT (mTLS)" as UC2
  usecase "Publier des\ndonnees telemetrie" as UC3
  usecase "Renouveler\nle certificat" as UC4

  ' --- Sous-cas inclus ---
  usecase "Verification\nchaine CA" as UC_VERIF
  usecase "Authentification\nmTLS" as UC_AUTH
  usecase "Chiffrement\nTLS 1.3" as UC_TLS

  ' --- Cas de l'Administrateur ---
  usecase "Configurer\nla PKI Vault" as UC5
  usecase "Definir les\nregles ACL" as UC6
  usecase "Configurer les\nregles IDS Suricata" as UC7
  usecase "Deployer les\nregles SIEM Wazuh" as UC8

  ' --- Cas de l'Operateur SOC ---
  usecase "Consulter le\ntableau de bord" as UC9
  usecase "Analyser les\nalertes IDS" as UC10
  usecase "Lancer la detection\nML d'anomalies" as UC11
  usecase "Evaluer les\nperformances" as UC12
}

' ── Ancrage : lien invisible pour forcer l'acteur systeme en haut a droite ──

UC_VERIF -[hidden]- DEV

' ── Liens Dispositif IoT (a droite/haut : associations sans tete) ──

UC1 -- DEV
UC2 -- DEV
UC3 -- DEV
UC4 -- DEV

' ── Liens Administrateur (associations : traits sans tete) ──

ADMIN -- UC5
ADMIN -- UC6
ADMIN -- UC7
ADMIN -- UC8

' ── Liens Operateur SOC (associations : traits sans tete) ──

SOC -- UC9
SOC -- UC10
SOC -- UC11
SOC -- UC12

' ── Inclusions (cas inclus places a gauche) ──

UC_VERIF <.. UC1 : <<include>>
UC_AUTH  <.. UC2 : <<include>>
UC_TLS   <.. UC2 : <<include>>
UC_TLS   <.. UC3 : <<include>>

@enduml
