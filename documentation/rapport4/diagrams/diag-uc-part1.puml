@startuml diag-uc-part1

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam shadowing false
skinparam usecase {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam actor {
  BackgroundColor #FAFAFA
  BorderColor #555555
}

title Cas d'utilisation --- Partie 1 : Dispositif IoT (Capteur)

left to right direction

rectangle "Dispositif IoT\n(Capteur)" as DEV

rectangle "Interactions du dispositif avec la plateforme" {
  usecase "Demander un\ncertificat X.509" as UC1
  usecase "Se connecter\nau broker MQTT" as UC2
  usecase "Publier des\ndonnées télémétrie" as UC3
  usecase "Renouveler\nle certificat" as UC4

  usecase "Vérification\nchaîne CA" as UC_VERIF
  usecase "Authentification\nmTLS" as UC_AUTH
  usecase "Chiffrement\nTLS 1.3" as UC_TLS
}

DEV --> UC1
DEV --> UC2
DEV --> UC3
DEV --> UC4

UC1 ..> UC_VERIF : <<include>>
UC2 ..> UC_AUTH  : <<include>>
UC2 ..> UC_TLS   : <<include>>
UC3 ..> UC_TLS   : <<include>>

@enduml
