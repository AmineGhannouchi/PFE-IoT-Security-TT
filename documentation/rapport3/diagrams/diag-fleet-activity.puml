@startuml diag-fleet-activity

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ActivityBackgroundColor #E3F2FD
skinparam ActivityBorderColor #1565C0

title Diagramme d'Activité — Simulateur de Flotte IoT\n(fleet_sim.py)

start

:Charger le dataset CSV\n(76 000 événements, 7 classes);

:Charger la configuration\ndu broker (IP, port 8883);

:Initialiser 50 threads\n(un par dispositif simulé);

fork
  :Thread Device-001;
fork again
  :Thread Device-002;
fork again
  :...;
fork again
  :Thread Device-050;
end fork

partition "Boucle par dispositif" {
  :Charger le certificat X.509\ndu dispositif (émis par Vault);

  :Configurer le client MQTT\navec TLS 1.3 / mTLS;

  :Établir connexion MQTT\nvers Mosquitto (port 8883);

  if (Connexion réussie ?) then (oui)

    :Récupérer le sous-ensemble\nd'événements CSV assigné\n(stratified sampling);

    repeat
      :Lire l'événement suivant\ndu dataset;

      :Formater le payload JSON\n(type, valeur, timestamp);

      :Publier sur le topic MQTT\niot/sensors/device-XXX/{type};

      :Attendre l'intervalle\ninter-messages (respect timing);

      if (Événement de type attaque ?) then (oui)
        :Adapter le comportement\n(DoS: accélérer, MiTM: modifier,\nReplay: dupliquer);
      else (non)
        :Publication normale;
      endif

    repeat while (Événements restants ?)

    :Déconnecter le client MQTT;

  else (non)
    :Logger l'erreur de connexion;
  endif
}

:Agréger les statistiques\n(messages envoyés, erreurs, durée);

:Générer le rapport de simulation;

stop

note right
  Résultats obtenus :
  — 76 000 messages publiés
  — 0% de perte (QoS 1)
  — 50 connexions TLS simultanées
  — Durée : ~30 minutes
  — Capture : 127 MB (pcap)
end note

@enduml
