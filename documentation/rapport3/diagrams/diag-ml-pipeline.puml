@startuml diag-ml-pipeline

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ActivityBackgroundColor #E0F2F1
skinparam ActivityBorderColor #00695C

title Diagramme d'Activité — Pipeline de Détection d'Anomalies ML

start

partition "1. Chargement et Exploration" {
  :Charger le dataset CSV\n(76 000 entrées, 24 features);

  :Analyse exploratoire (EDA)\n— Distribution des classes\n— Corrélation des features\n— Boxplots par type d'attaque;

  :Identifier les valeurs manquantes\net les types de données;
}

partition "2. Feature Engineering" {
  :Encoder les variables catégorielles\n(LabelEncoder)\n— protocol, tls_version, auth_method\n— cert_status, src_zone, dst_zone\n— message_type, device_type;

  :Sélectionner les 29 features\n(numériques + encodées);

  :Créer les labels\n— label_secure : binaire (0/1)\n— attack_type : multi-classe (7 types);
}

fork

partition "3a. IsolationForest\n(Non supervisé)" #FFECB3 {
  :Entraîner sur données normales\n(label_secure = 1);

  :Paramètres :\n— n_estimators = 200\n— contamination = 0.43\n— max_features = 0.8;

  :Prédire sur tout le dataset\n— Score d'anomalie\n— Seuil de décision;

  :Résultats :\n— F1 = 0.930\n— ROC-AUC = 0.959;
}

fork again

partition "3b. RandomForest Binaire\n(Supervisé)" #E3F2FD {
  :Split train/test stratifié\n(80% / 20%);

  :Entraîner RandomForest\n— n_estimators = 200\n— max_depth = 20\n— class_weight = balanced;

  :Prédire sur l'ensemble test;

  :Résultats :\n— F1 = 0.994\n— ROC-AUC = 0.999;

  :Analyser l'importance\ndes features (Top 20);
}

fork again

partition "3c. RandomForest Multi-classes\n(7 types d'attaques)" #FCE4EC {
  :Entraîner sur les 7 classes\n— Normal, DoS, MiTM, Replay\n— FalsifiedData, Scanning, Malware;

  :Matrice de confusion\nmulti-classes;

  :Résultats :\n— F1 = 0.988\n— ROC-AUC = 0.998;
}

end fork

partition "4. Comparaison et Export" {
  :Comparer les 3 modèles\n(métriques, avantages, limites);

  :Sauvegarder les modèles\n(joblib — .pkl);

  :Générer les visualisations\n(matplotlib / seaborn);
}

stop

note right
  **Conclusion ML :**
  — RandomForest : quasi-parfait
    avec étiquettes (F1=0.994)
  — IsolationForest : viable sans
    étiquettes (F1=0.930)
  — Complémentarité supervisé /
    non supervisé validée
end note

@enduml
