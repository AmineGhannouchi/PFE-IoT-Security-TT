# ============================================================
# PFE IoT Security — Règles Suricata MQTT/TLS
# Phase 6 — Analyse réseau
# ============================================================

# ----- Règle 1 : Toute connexion TLS vers le broker (baseline) -----
alert tls any any -> 192.168.20.10 8883 \
  (msg:"PFE [INFO] TLS connection to MQTT broker 8883"; \
   tls.version:"TLS 1.3"; \
   sid:1000001; rev:2;)

# ----- Règle 2 : JA4 fingerprint connu du fleet-sim -----
# JA4 visible dans eve.json : t13i030900_55b375c5d22e_3217d83565aa
alert tls any any -> 192.168.20.10 8883 \
  (msg:"PFE [INFO] Known fleet-sim client JA4 fingerprint"; \
   ja4:"t13i030900_55b375c5d22e_3217d83565aa"; \
   sid:1000002; rev:1;)

# ----- Règle 3 : DoS — trop de connexions TLS depuis une même IP -----
# DoS burst = flood de nouveaux handshakes TLS (20+ en quelques secondes)
alert tcp any any -> 192.168.20.10 8883 \
  (msg:"PFE [ALERT] DoS - Excessive TLS connections to MQTT broker"; \
   flags:S; \
   threshold: type threshold, track by_src, count 15, seconds 10; \
   sid:1000010; rev:1;)

# ----- Règle 4 : Scan / connexion depuis réseau non-IoT -----
# Seul le réseau IoT 192.168.10.0/24 doit contacter le broker
alert tls !192.168.10.0/24 any -> 192.168.20.10 8883 \
  (msg:"PFE [ALERT] Unauthorized network connecting to MQTT broker"; \
   sid:1000011; rev:1;)

# ----- Règle 5 : Volume élevé de données (Replay / DoS payload) -----
# Un seul flux TCP avec beaucoup de bytes en peu de temps
alert tcp 192.168.10.0/24 any -> 192.168.20.10 8883 \
  (msg:"PFE [WARN] High volume TCP flow to MQTT broker"; \
   flow:established,to_server; \
   threshold: type threshold, track by_src, count 50, seconds 5; \
   sid:1000012; rev:1;)

# ----- Règle 6 : TLS version < 1.3 (downgrade attempt) -----
alert tls any any -> 192.168.20.10 8883 \
  (msg:"PFE [ALERT] TLS downgrade attempt - version below 1.3"; \
   tls.version:!"TLS 1.3"; \
   sid:1000020; rev:1;)